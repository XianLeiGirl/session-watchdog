/systemd/codex-session-watchdog.service
/systemd/codex-feishu-error-notifier.service

# Python caches and test output
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Editor and operating-system files
.DS_Store
*.swp
*~
